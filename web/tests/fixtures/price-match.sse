data: {"passages": [{"id": 6, "document": "repairs.md", "title": "Repairs and servicing", "page": null, "heading_path": ["Repairs and servicing", "Services and prices"], "text": "We always ask before fitting a part that costs more\nthan £20.", "start": 450, "end": 511, "score": 0.3461}, {"id": 17, "document": "shipping.md", "title": "Shipping", "page": null, "heading_path": ["Shipping", "Delivery options and costs"], "text": "Standard delivery takes 3 to 5 working days and costs £4.95.\n- Standard delivery is free on orders over £50.\n- Next-day delivery costs £9.95 if you order by 2pm on a working day.", "start": 212, "end": 390, "score": 0.2833}, {"id": 4, "document": "repairs.md", "title": "Repairs and servicing", "page": null, "heading_path": ["Repairs and servicing", "Services and prices"], "text": "A basic service costs £45. It covers gears and brakes adjusted, the chain cleaned and oiled, and\n  a safety check.\n- A full service costs £95.", "start": 51, "end": 193, "score": 0.2647}, {"id": 2, "document": "membership.md", "title": "Quillbrook Club membership", "page": null, "heading_path": ["Quillbrook Club membership", "What you get"], "text": "10% off parts and accessories. The discount doesn't apply to bikes or to servicing.\n- A free safety check once a year.\n- Early access to our sales, one day before everyone else.", "start": 97, "end": 274, "score": 0.2218}, {"id": 19, "document": "shipping.md", "title": "Shipping", "page": null, "heading_path": ["Shipping", "Click and collect"], "text": "You can order online and collect from the shop, usually the next working day. We hold orders for\n14 days.", "start": 611, "end": 716, "score": 0.2192}], "top_score": 0.3461, "threshold": 0.55, "confident": false}

